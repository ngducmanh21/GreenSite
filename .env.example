# Copy to .env at repository root. Do not put secrets in frontend/.env.local.
# Local npm run dev/start creates an ephemeral internal token if this is absent.
# Docker Compose requires an explicit token; generate one with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# Optional; local default is ./data/greensite.sqlite. Docker uses a named volume.
# DATABASE_PATH=/absolute/path/to/greensite.sqlite
# Optional pilot: set a random 32+ character root token to create organizations.
# This secret is passed only to the Site service; keep it private.
PILOT_ROOT_TOKEN=
# Only assistant service receives these:
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ACCESS_TOKEN=

# Vercel cloud image explicitly enables read-only demo until a hosted DB is added.
# GREENSITE_DEMO_MODE=1
