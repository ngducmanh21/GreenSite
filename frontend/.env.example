# Optional OpenAI integration. All values are SERVER-ONLY; never use NEXT_PUBLIC_.
# Copy to .env.local, choose a model available in your OpenAI project, then restart.
OPENAI_API_KEY=
OPENAI_MODEL=
# Generate a long random access token for the demo (e.g. openssl rand -hex 32).
# Enter this token in the app when selecting OpenAI mode. Do NOT enter your API key.
AI_ACCESS_TOKEN=
